# Ignore BEMYAGENT drafts but keep the templates
.bemyagent/docs/drafts/*
!.bemyagent/docs/drafts/_template.md

# Ephemeral upgrade plan (created during upgrade, deleted after apply)
.bemyagent/upgrade-plan.md

# Generated site (built by CI)
site/output/

# harness fixture artifacts
harness/fixture/game.db
harness/fixture/node_modules/

# transient audit output from development scripts
.bemyagent/work/audit-latest.log

# conversation log — the personal switch and the log itself (local only)
.claude/settings.local.json
.bemyagent/log/

# machine-local paths for the 21.1 apparatus (never tracked)
local.env

# compiled Python left by the apparatus scripts (they embed the machine's paths)
__pycache__/
